---
interface Props {
  class?: string;
  size?: "md" | "lg";
  [key: string]: unknown;
}

const { class: className = "", size = "md", ...rest } = Astro.props;

const sizeClasses: Record<string, string> = {
  md: "text-base md:text-lg",
  lg: "text-lg md:text-xl lg:text-2xl",
};
---

<p
  class:list={[
    "text-us-ink/70 dark:text-us-paper/70 leading-relaxed text-pretty",
    sizeClasses[size],
    className,
  ]}
  {...rest}
>
  <slot />
</p>
