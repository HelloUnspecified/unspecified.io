---
/**
 * The open-bracket frame from the Unspecified logo: a brass hairline box
 * whose bottom edge breaks in the middle to hold a small caption, the way
 * "SOFTWARE CO" sits in the logo. Use it once or twice per page, not on
 * everything.
 */
interface Props {
  caption?: string;
  /** Make the caption a link (e.g. "#troth"). */
  captionHref?: string;
  class?: string;
}

const { caption, captionHref, class: className = "" } = Astro.props;
const CaptionTag = captionHref ? "a" : "span";
---

<div
  class:list={["relative rounded-[14px] border border-us-brass/70", className]}
>
  <slot />
  {
    caption && (
      <CaptionTag
        href={captionHref}
        class:list={[
          "absolute left-1/2 bottom-0 -translate-x-1/2 translate-y-1/2 px-4 font-mono text-[11px] md:text-xs uppercase tracking-[0.24em] whitespace-nowrap text-us-brass",
          captionHref && "hover:text-us-red transition-colors",
        ]}
        style="background: var(--surface)"
      >
        {caption}
      </CaptionTag>
    )
  }
</div>
