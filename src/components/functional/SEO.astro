---
import { SITE } from "../../config/site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title = SITE.name,
  description = SITE.description,
  canonical,
  ogImage = "/og-image.png",
  ogType = "website",
  noindex = false,
  jsonLd,
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, SITE.url).href;
const ogImageURL = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage, SITE.url).href;

const organization = {
  "@type": "Organization",
  "@id": `${SITE.url}/#organization`,
  name: SITE.name,
  alternateName: SITE.shortName,
  url: SITE.url,
  logo: {
    "@type": "ImageObject",
    url: `${SITE.url}/assets/img/logo/unspecified-logo.svg`,
  },
  description: SITE.description,
  email: SITE.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: SITE.address.locality,
    addressRegion: SITE.address.region,
    addressCountry: SITE.address.country,
  },
  founder: [
    { "@id": `${SITE.url}/#clark` },
    {
      "@type": "Person",
      name: "Carrie Sell",
      jobTitle: "Chief Operating Officer",
      worksFor: { "@id": `${SITE.url}/#organization` },
    },
  ],
  sameAs: SITE.socials.unspecified.links.map((l) => l.url),
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    email: SITE.email,
    url: `${SITE.url}/contact`,
  },
  owns: { "@id": `${SITE.products.troth.url}/#app` },
};

const clark = {
  "@type": "Person",
  "@id": `${SITE.url}/#clark`,
  name: "Clark Sell",
  jobTitle: "Founder",
  worksFor: { "@id": `${SITE.url}/#organization` },
  url: `${SITE.url}/about`,
  image: `${SITE.url}/assets/img/people/clark-on-stage.jpg`,
  sameAs: SITE.socials.clark.links.map((l) => l.url),
  knowsAbout: [
    "Software engineering",
    "Community building",
    "Conference production",
  ],
};

const troth = {
  "@type": "SoftwareApplication",
  "@id": `${SITE.products.troth.url}/#app`,
  name: SITE.products.troth.name,
  url: SITE.products.troth.url,
  applicationCategory: "LifestyleApplication",
  operatingSystem: "iOS",
  description: SITE.products.troth.tagline,
  author: { "@id": `${SITE.url}/#organization` },
  sameAs: SITE.socials.troth.links.map((l) => l.url),
};

const website = {
  "@type": "WebSite",
  "@id": `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  publisher: { "@id": `${SITE.url}/#organization` },
  inLanguage: "en-US",
};

// Every page carries the org, founder, product and site entities; pages can
// add their own graph via `jsonLd` and it is merged in.
const supplied: Record<string, unknown>[] = jsonLd
  ? ((jsonLd["@graph"] as Record<string, unknown>[] | undefined) ?? [jsonLd])
  : [];
const extra = supplied.map(({ "@context": _context, ...entity }) => entity);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [organization, clark, troth, website, ...extra],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
<meta name="author" content={SITE.name} />
<meta
  name="theme-color"
  content="#f4f1ea"
  media="(prefers-color-scheme: light)"
/>
<meta
  name="theme-color"
  content="#141416"
  media="(prefers-color-scheme: dark)"
/>

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="en_US" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:creator" content="@TheClarkSell" />

<!-- Structured Data -->
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(structuredData)}
></script>
