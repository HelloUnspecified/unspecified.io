---
import SectionLabel from "../../elements/SectionLabel.astro";
import Heading from "../../elements/Heading.astro";
import BodyText from "../../elements/BodyText.astro";
import CTAButton from "../../elements/CTAButton.astro";
import { SITE } from "../../config/site";

const mailto = `mailto:${SITE.email}?subject=${encodeURIComponent("Speaking inquiry")}`;
---

<section id="speaking" class="py-20 md:py-28 scroll-mt-24">
  <div class="container-default">
    <div
      class="hairline pt-14 md:pt-20 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16 lg:items-center"
    >
      <figure class="lg:col-span-7" data-reveal>
        <div
          class="relative overflow-hidden rounded-[14px] border border-us-brass/50"
        >
          <img
            src="/assets/img/people/clark-on-stage.jpg"
            alt="Clark Sell on stage at THAT Conference in front of a slide that reads: What has heart and meaning for you?"
            width="799"
            height="533"
            loading="lazy"
            decoding="async"
            class="block w-full h-auto aspect-3/2 object-cover"
          />
          <figcaption
            class="absolute bottom-0 inset-x-0 px-5 py-4 bg-linear-to-t from-us-ink/80 to-transparent font-mono text-[11px] uppercase tracking-[0.2em] text-us-paper/90"
          >
            Clark on stage at THAT Conference
          </figcaption>
        </div>
      </figure>

      <div class="lg:col-span-5">
        <div data-reveal>
          <SectionLabel number="05" text="Speaking" />
        </div>
        <Heading size="md" class="mt-8 max-w-[16ch]" data-reveal
          >Clark speaks.</Heading
        >
        <BodyText class="mt-6 max-w-[44ch]" data-reveal>
          Keynotes, workshops, and podcasts on building software, building
          communities, and the people side of both. Twenty-five years of
          shipping, a decade of running THAT Conference, and now Troth.
        </BodyText>
        <div
          class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4"
          data-reveal
        >
          <CTAButton href={mailto} variant="contrast"
            >Invite Clark to speak</CTAButton
          >
          <CTAButton href="/contact" variant="link">Contact</CTAButton>
        </div>
      </div>
    </div>
  </div>
</section>
