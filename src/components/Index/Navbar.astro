---
import Logo from "../functional/Logo.astro";
import { SITE } from "../../config/site";

const links = [
  { href: "/about", label: "About" },
  { href: SITE.products.troth.url, label: "Troth", external: true },
  { href: "/contact", label: "Contact" },
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-100 transition-[background-color,border-color,backdrop-filter] duration-300 border-b border-transparent"
>
  <div class="container-default flex items-center justify-between py-4 md:py-5">
    <a href="/" class="shrink-0" aria-label="Unspecified Software Co. home">
      <Logo height={30} class="md:h-[34px]!" priority />
    </a>

    <nav aria-label="Primary" class="flex items-center gap-4 md:gap-8">
      {
        links.map((l) => {
          const active = !l.external && current === l.href;
          return (
            <a
              href={l.href}
              target={l.external ? "_blank" : undefined}
              rel={l.external ? "noopener noreferrer" : undefined}
              aria-current={active ? "page" : undefined}
              class:list={[
                "link-draw font-mono text-[11px] md:text-xs uppercase tracking-[0.14em] md:tracking-[0.2em] transition-colors duration-200",
                active
                  ? "text-us-red"
                  : "text-us-ink/70 hover:text-us-ink dark:text-us-paper/70 dark:hover:text-us-paper",
              ]}
            >
              {l.label}
              {l.external && (
                <span aria-hidden="true" class="text-us-brass">
                  ↗
                </span>
              )}
            </a>
          );
        })
      }

      <button
        id="theme-toggle"
        type="button"
        class="ml-0 md:ml-1 inline-flex h-8 w-8 items-center justify-center rounded-full text-us-ink/60 hover:text-us-red dark:text-us-paper/60 dark:hover:text-us-red transition-colors cursor-pointer"
        aria-label="Toggle color theme"
      >
        <svg
          class="h-4 w-4 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
        <svg
          class="hidden h-4 w-4 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("us-theme", dark ? "dark" : "light");
    } catch {}
  });

  const header = document.getElementById("site-header");
  const solid = [
    "backdrop-blur-md",
    "bg-us-paper/85",
    "dark:bg-us-ink/80",
    "border-us-brass/20",
  ];
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 24) header.classList.add(...solid);
    else header.classList.remove(...solid);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
